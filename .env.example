# ==============================================================================
# MadadgaarAI Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the variables to customize your local setup.

# Application Server Host & Port
MADADGAAR_HOST=0.0.0.0
MADADGAAR_PORT=8000
MADADGAAR_DEBUG=True

# Embedding & Search Engine Configuration
# Supported sentence transformer models: all-MiniLM-L6-v2, paraphrase-MiniLM-L3-v2
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RRF_K_CONSTANT=60
DEFAULT_TOP_K=5

# Hugging Face Hub Offline Mode (Set to 1 once model is cached locally for faster boots)
HF_HUB_OFFLINE=0

# PDF & OCR Extraction Parameters
MIN_TEXT_DENSITY_CHARS_PER_PAGE=120
MAX_OCR_PAGES=15

# Tesseract OCR Executable Path (Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Database & Storage Configuration
# Local SQLite default (WAL mode) + Production PostgreSQL with pgvector
DATABASE_URL=postgresql://saral:saral_dev_password@localhost:5432/saral_ai
# MADADGAAR_DB_PATH=./data/processed/madadgaar.db
# MADADGAAR_VECTOR_INDEX_PATH=./data/processed/vector_index.json

# Google OAuth 2.0 & JWT Session Security (Saral AI Multi-Tenant Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
JWT_SECRET_KEY=replace-with-64-char-random-hex-secret
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
COOKIE_SECURE=false
ALLOW_LOCAL_DEV_AUTH=true
MADADGAAR_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Google Gemini API (Official google-genai SDK)
GEMINI_API_KEY=
SARAL_GEMINI_MODEL=gemini-2.5-flash
SARAL_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
MADADGAAR_GEMINI_MODEL=gemini-2.5-flash

# Optional Secondary LLM Providers (Auto-falls back to Grounded Offline RAG if unset)
# OPENAI_API_KEY=
# MADADGAAR_OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434
# MADADGAAR_OLLAMA_MODEL=llama3.2
